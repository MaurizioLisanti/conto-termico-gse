# conto-termico-gse — configurazione
#
# Copia questo file in .env e compila i valori reali:
#   cp .env.example .env
#
# .env e in .gitignore e non deve mai essere committato.

# ── Weaviate Cloud (obbligatorio) ────────────────────────────
# Cluster su https://console.weaviate.cloud — free tier 14 giorni.
# L'URL e quello mostrato nella console, senza slash finale.
WCD_URL=https://il-tuo-cluster.weaviate.network
WCD_API_KEY=__CHANGE_ME__

# ── Provider LLM (serve UNO dei due) ─────────────────────────
# main.py verifica prima OPENAI_API_KEY, poi GEMINI_API_KEY, e
# solleva EnvironmentError se non trova nessuna delle due.
#
# Opzione A — OpenAI: base gpt-4.1-mini, complex gpt-4.1
OPENAI_API_KEY=__CHANGE_ME__
#
# Opzione B — Google Gemini: base gemini-2.0-flash, complex gemini-2.0-pro
# GEMINI_API_KEY=__CHANGE_ME__
